    /**
     * Level 2 view when a subStack filter is given (the roll-up collection has no subStack).
     */
    @Aggregation(pipeline = {
        "{ '$match': { '$and': [ " +
            "{ 'appId': ?0 }, " +
            "{ 'runId': { '$in': ?1 } }, " +
            "{ '$or': [ " +
            "   { '$expr': { '$eq': [ { '$size': { '$ifNull': [ ?2, [] ] } }, 0 ] } }, " +
            "   { 'stack': { '$in': ?2 } } " +
            "] }, " +
            "{ '$or': [ " +
            "   { '$expr': { '$eq': [ { '$size': { '$ifNull': [ ?3, [] ] } }, 0 ] } }, " +
            "   { 'status': { '$in': ?3 } } " +
            "] }, " +
            "{ '$or': [ " +
            "   { '$expr': { '$eq': [ { '$size': { '$ifNull': [ ?4, [] ] } }, 0 ] } }, " +
            "   { 'subStack': { '$in': ?4 } } " +
            "] } " +
            "] } }",

        // Keep only fields needed for dedupe + status rollup
        "{ '$project': { " +
            "'appId': 1, 'datacenter': 1, 'stack': 1, 'component': 1, " +
            "'priority': { '$switch': { " +
            "  'branches': [ " +
            "    { 'case': { '$eq': [ '$status', 'ACTIVE' ] }, 'then': 0 }, " +
            "    { 'case': { '$eq': [ '$status', 'IDLE' ] }, 'then': 1 }, " +
            "    { 'case': { '$eq': [ '$status', 'DEPLOYED_ONLY' ] }, 'then': 2 } " +
            "  ], 'default': 999 } } " +
            "} }",

        // Dedupe per component by best status priority
        "{ '$group': { " +
            "'_id': { 'appId': '$appId', 'datacenter': '$datacenter', 'stack': '$stack', 'component': '$component' }, " +
            "'bestPriority': { '$min': '$priority' } " +
            "} }",

        // Roll up to app/datacenter/stack (Level 2 shape)
        "{ '$group': { " +
            "'_id': { 'appId': '$_id.appId', 'datacenter': '$_id.datacenter', 'stack': '$_id.stack' }, " +
            "'deployed': { '$sum': 1 }, " +
            "'active': { '$sum': { '$cond': [ { '$eq': [ '$bestPriority', 0 ] }, 1, 0 ] } }, " +
            "'idle': { '$sum': { '$cond': [ { '$eq': [ '$bestPriority', 1 ] }, 1, 0 ] } }, " +
            "'deployedOnly': { '$sum': { '$cond': [ { '$eq': [ '$bestPriority', 2 ] }, 1, 0 ] } } " +
            "} }",

        "{ '$addFields': { " +
            "'status': { '$switch': { " +
            "  'branches': [ " +
            "    { 'case': { '$eq': [ '$active', '$deployed' ] }, 'then': 'ACTIVE' }, " +
            "    { 'case': { '$eq': [ '$idle', '$deployed' ] }, 'then': 'IDLE' }, " +
            "    { 'case': { '$eq': [ '$deployedOnly', '$deployed' ] }, 'then': 'DEPLOYED_ONLY' }, " +
            "    { 'case': { '$and': [ { '$gt': [ '$active', 0 ] }, { '$gt': [ '$idle', 0 ] }, { '$eq': [ '$deployedOnly', 0 ] } ] }, 'then': 'ACTIVE_AND_IDLE' }, " +
            "    { 'case': { '$and': [ { '$gt': [ '$active', 0 ] }, { '$gt': [ '$deployedOnly', 0 ] }, { '$eq': [ '$idle', 0 ] } ] }, 'then': 'ACTIVE_AND_DEPLOYED_ONLY' }, " +
            "    { 'case': { '$and': [ { '$gt': [ '$idle', 0 ] }, { '$gt': [ '$deployedOnly', 0 ] }, { '$eq': [ '$active', 0 ] } ] }, 'then': 'IDLE_AND_DEPLOYED_ONLY' }, " +
            "    { 'case': { '$and': [ { '$gt': [ '$active', 0 ] }, { '$gt': [ '$idle', 0 ] }, { '$gt': [ '$deployedOnly', 0 ] } ] }, 'then': 'ACTIVE_IDLE_DEPLOYED_ONLY' } " +
            "  ], 'default': 'UNKNOWN' } } " +
            "} }",

        "{ '$project': { " +
            "'_id': 0, " +
            "'appId': '$_id.appId', " +
          "'datacenter': '$_id.datacenter', " +
          "'stack': '$_id.stack', " +
          "'deployed': 1, " +
            "'active': 1, " +
            "'deployedOnly': 1, " +
            "'idle': 1, " +
            "'status': 1, " +
            "'runId': null, " +
            "'evaluatedAt': null " +
            "} }"
    })
    List<AppDatacenterStackSummary> findStackSummaryForAppBySubStack(
        String appId,
        List<Long> runIds,
        List<String> stack,
        List<String> status,
        List<String> subStack
    );

