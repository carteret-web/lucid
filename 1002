    @Test
    void getAppStackSummary_whenSubStackGiven_usesComponentRepoWithRunId() {
        WimaAppDatacenterSummaryRequest request = new WimaAppDatacenterSummaryRequest();
        request.setRunId(1234L);
        request.setSubStack(List.of("ORACLE"));

        when(appDatacenterStackComponentSummaryRepository.findStackSummaryForAppBySubStack(
            "app1", List.of(1234L), null, null, List.of("ORACLE")
        )).thenReturn(List.of(new AppDatacenterStackSummary()));

        List<AppDatacenterStackSummary> result = wimaService.getAppStackSummary("app1", request);

        assertEquals(1, result.size());
        verify(appDatacenterStackComponentSummaryRepository, times(1))
            .findStackSummaryForAppBySubStack("app1", List.of(1234L), null, null, List.of("ORACLE"));
        verify(appDatacenterStackSummaryRepository, never())
            .findStackSummaryForAppByRunId(anyString(), any(), any(), any());
    }

